# Providers, models and API keys live in the app: providers.json (non-secret)
# plus the OS keyring (secrets). Configure them in Settings - this file is
# only the legacy plaintext fallback for an API key when a provider has no
# keyring entry, borrowed only when BASE_URL matches the provider's host.
BASE_URL=https://your-provider.example/v1
API_KEY=put-your-key-here
# CONTEXT_WINDOW=128000
